# Copy to apps/backend_py/.env and fill in. Loaded by app/config.py at startup.
# Groq key for query translate + caption-rewrite (query_rewrite.py). Get one at
# https://console.groq.com/keys — without it, search falls back to a static
# "a photo of {q}" template (no translation).
GROQ_API_KEY=

# optional overrides:
# GROQ_QUERY_MODEL=llama-3.1-8b-instant
# GROQ_QUERY_TIMEOUT_S=3.0

# Wall-clock timestamps printed in the forensic PDF report. Stored tracklet times carry a
# real time-of-day but only a placeholder date (the ingest constant SCENE_BASE_WALL), so
# set the true recording date per scene here. Scenes left out fall back to the placeholder
# and the report/manifest say so explicitly.
# RECORDING_DATES=SUR01=2025-11-14,surat-live=2025-11-14
# RECORDING_TIMEZONE=IST (UTC+05:30)
