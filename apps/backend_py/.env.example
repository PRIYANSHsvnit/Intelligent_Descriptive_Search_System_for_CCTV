# Copy to apps/backend_py/.env and fill in. Loaded by app/config.py at startup.
# Groq key for query translate + caption-rewrite (query_rewrite.py). Get one at
# https://console.groq.com/keys — without it, search falls back to a static
# "a photo of {q}" template (no translation).
GROQ_API_KEY=

# optional overrides:
# GROQ_QUERY_MODEL=llama-3.1-8b-instant
# GROQ_QUERY_TIMEOUT_S=3.0
